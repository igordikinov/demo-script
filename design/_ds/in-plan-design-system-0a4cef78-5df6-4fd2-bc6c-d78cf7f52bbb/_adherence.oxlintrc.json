{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icon/**",
              "components/navigation/**",
              "components/overlay/**",
              "ui_kits/scp-shell/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Open Sans|Material Icons))/i]",
        "message": "Font not provided by the design system. Available: Open Sans, Material Icons."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|modifier|size|disabled|fullWidth|onClick|type|title|style|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, color, modifier, size, disabled, fullWidth, onClick, type, title, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|sub-primary|sub-primary-text|sub-primary-color|sub-secondary-text|warn)$/]",
        "message": "<Button> color must be one of 'primary' | 'sub-primary' | 'sub-primary-text' | 'sub-primary-color' | 'sub-secondary-text' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='modifier'] > Literal[value!=/^(?:flat|stroked|icon-flat|icon-stroked|link)$/]",
        "message": "<Button> modifier must be one of 'flat' | 'stroked' | 'icon-flat' | 'icon-stroked' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm|xs)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|label|size|disabled|invalid|indeterminate|style|className|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, label, size, disabled, invalid, indeterminate, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|subtitle|children|footer|okText|cancelText|onOk|onCancel|onClose|showClose|width|inline|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, subtitle, children, footer, okText, cancelText, onOk, onCancel, onClose, showClose, width, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|okText|cancelText|onOk|onCancel|onClose|width|resizable|style|key|ref|className|style|children)$/]",
        "message": "<Drawer> doesn't accept that prop. Declared props: open, title, children, footer, okText, cancelText, onOk, onCancel, onClose, width, resizable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExpandableText'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|expanded|style|className|key|ref|className|style|children)$/]",
        "message": "<ExpandableText> doesn't accept that prop. Declared props: title, children, expanded, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldError'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<FieldError> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldHint'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<FieldHint> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hint|error|style|className|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: children, hint, error, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormState'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|title|style|className|key|ref|className|style|children)$/]",
        "message": "<FormState> doesn't accept that prop. Declared props: state, title, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|width|height|stroke|fill|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, width, height, stroke, fill, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicativeScale'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|orientation|colorRanges|percent|style|key|ref|className|style|children)$/]",
        "message": "<IndicativeScale> doesn't accept that prop. Declared props: value, min, max, orientation, colorRanges, percent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicativeScale'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<IndicativeScale> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|placeholder|disabled|invalid|size|type|style|className|inputProps|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, placeholder, disabled, invalid, size, type, style, className, inputProps."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Input> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:readable|writable|forcedFocus|onFocused|onBlurred|style|className|key|ref|className|style|children)$/]",
        "message": "<InputSwitcher> doesn't accept that prop. Declared props: readable, writable, forcedFocus, onFocused, onBlurred, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loading'] > JSXAttribute > JSXIdentifier[name!=/^(?:isLoading|style|className|key|ref|className|style|children)$/]",
        "message": "<Loading> doesn't accept that prop. Declared props: isLoading, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|children|small|style|className|key|ref|className|style|children)$/]",
        "message": "<Note> doesn't accept that prop. Declared props: type, children, small, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<Note> type must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|icon|isPinned|key|ref|className|style|children)$/]",
        "message": "<PageTab> doesn't accept that prop. Declared props: id, title, icon, isPinned."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|size|disabled|name|value|style|className|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, onChange, label, size, disabled, name, value, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollContainer'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|height|maxHeight|style|className|key|ref|className|style|children)$/]",
        "message": "<ScrollContainer> doesn't accept that prop. Declared props: children, height, maxHeight, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|options|onChange|disabled|invalid|size|placeholder|style|className|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, value, options, onChange, disabled, invalid, size, placeholder, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Select> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|label|size|disabled|style|className|key|ref|className|style|children)$/]",
        "message": "<SlideToggle> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, label, size, disabled, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|placeholder|rows|disabled|invalid|style|className|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, placeholder, rows, disabled, invalid, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|position|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: text, position, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> position must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WidgetColorRange'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|from|to|key|ref|className|style|children)$/]",
        "message": "<WidgetColorRange> doesn't accept that prop. Declared props: type, from, to."
      },
      {
        "selector": "JSXOpeningElement[name.name='WidgetColorRange'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:error|warning|success)$/]",
        "message": "<WidgetColorRange> type must be one of 'error' | 'warning' | 'success'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
